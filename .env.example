# Copy to .env and fill in. .env is git-ignored.

# Claude API. Leave empty if you use `ant auth login` instead.
ANTHROPIC_API_KEY=

# Required by the SEC for every automated request: a name and a contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name your.email@example.com"

# 1 = answer SEC requests only from data/cache/sec (eval runs use this for reproducibility).
FA_SEC_OFFLINE=0

# Optional: raises GitHub API limits when downloading FinanceBench.
GITHUB_TOKEN=

# Models (agent and judge should differ to limit self-preference in grading).
FA_AGENT_MODEL=claude-opus-5-5
FA_JUDGE_MODEL=claude-sonnet-5-5

# Hard cap on API spend for a single eval run, in USD.
FA_MAX_COST_USD=20

# Optional overrides for where data and results live.
# FA_DATA_DIR=data
# FA_RESULTS_DIR=results
